# Production Supabase configuration
# Get these values from your Supabase project dashboard at https://app.supabase.com
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_production_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_production_service_role_key_here

# Database connection (for cloud deployments)
DATABASE_URL=postgresql://postgres.XXXXXXXXXX:your_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# API configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=False

# Frontend configuration
FRONTEND_URL=https://your-frontend-domain.com

# Email service (configure your provider)
EMAIL_PROVIDER=sendgrid  # or your provider
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587

# Storage (using Supabase cloud S3)
STORAGE_URL=https://your-project-id.supabase.co/storage/v1/s3
STORAGE_ACCESS_KEY=your_production_access_key
STORAGE_SECRET_KEY=your_production_secret_key
STORAGE_REGION=us-east-1
STORAGE_BUCKET=marketplace-items

# JWT configuration
JWT_SECRET=your_production_jwt_secret_here
JWT_EXPIRY=3600

# Feature flags
ENABLE_ALERTS=true
ENABLE_STORAGE=true
REQUIRE_EMAIL_VERIFICATION=true
